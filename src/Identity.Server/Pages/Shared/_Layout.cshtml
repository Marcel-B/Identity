@using Identity.Server.Options
@using Microsoft.Extensions.Options
@inject IOptions<ServerOptions> ServerOptions
@inject SignInManager<ApplicationUser> SignInManager
@{
    var appName = ServerOptions.Value.DisplayName;
    var signedIn = SignInManager.IsSignedIn(User);
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} · {appName}" : appName)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" href="~/">
            <span class="logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            @appName
        </a>
        <nav>
            @if (signedIn)
            {
                <a asp-page="/Account/Manage/Index">Mein Konto</a>
                @if (User.IsInRole(DatabaseInitializer.AdminRole))
                {
                    <a asp-page="/Admin/Index">Verwaltung</a>
                }
                <form method="post" asp-page="/Account/Logout" class="inline">
                    <button type="submit" class="link">Abmelden</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login">Anmelden</a>
            }
        </nav>
    </header>
    <main class="@(ViewData["Wide"] is true ? "wide" : "narrow")">
        <partial name="_Messages" />
        @RenderBody()
    </main>
    <footer class="site-footer">
        @appName · <a href="~/.well-known/openid-configuration">OpenID-Connect-Konfiguration</a>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
