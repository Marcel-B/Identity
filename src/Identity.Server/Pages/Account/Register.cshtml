@page
@model RegisterModel
@{
    ViewData["Title"] = "Konto erstellen";
}
<div class="card">
    <h1>Konto erstellen</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.DisplayName"></label>
        <input asp-for="Input.DisplayName" autocomplete="name" />
        <span asp-validation-for="Input.DisplayName" class="field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>
        <p class="muted">Mindestens 10 Zeichen mit Groß- und Kleinbuchstaben und einer Ziffer.</p>

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <button type="submit" class="block">Konto erstellen</button>
    </form>
    <p class="muted">Schon ein Konto? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Anmelden</a></p>
</div>
