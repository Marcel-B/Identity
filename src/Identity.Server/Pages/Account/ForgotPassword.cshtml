@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Passwort vergessen";
}
<div class="card">
    <h1>Passwort vergessen</h1>
    @if (Model.Sent)
    {
        <p>Wenn es ein Konto mit dieser Adresse gibt, haben wir dir einen Link zum Zurücksetzen geschickt.</p>
    }
    else
    {
        <form method="post">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
            <button type="submit" class="block">Link anfordern</button>
        </form>
    }
</div>
