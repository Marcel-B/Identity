@page
@model PasswordModel
@{
    ViewData["Title"] = "Passwort";
    ViewData["ManagePage"] = "password";
}
<h1>Mein Konto</h1>
<partial name="_ManageNav" />
<div class="card">
    <h2>@(Model.HasPassword ? "Passwort ändern" : "Passwort festlegen")</h2>
    @if (!Model.HasPassword)
    {
        <p class="muted">Du meldest dich bisher nur über ein externes Konto oder einen Passkey an. Mit einem Passwort geht es auch ohne.</p>
    }
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        @if (Model.HasPassword)
        {
            <label asp-for="Input.CurrentPassword"></label>
            <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.CurrentPassword" class="field-error"></span>
        }
        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <div class="actions"><button type="submit">Speichern</button></div>
    </form>
</div>
