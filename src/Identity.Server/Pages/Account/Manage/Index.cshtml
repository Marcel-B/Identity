@page
@model IndexModel
@{
    ViewData["Title"] = "Mein Konto";
    ViewData["ManagePage"] = "profile";
}
<h1>Mein Konto</h1>
<partial name="_ManageNav" />
<div class="card">
    <h2>Profil</h2>
    <p>E-Mail: <strong>@Model.Email</strong>
        @if (Model.EmailConfirmed)
        {
            <span class="badge">bestätigt</span>
        }
        else
        {
            <span class="badge">nicht bestätigt</span>
        }
    </p>
    @if (!Model.EmailConfirmed)
    {
        <form method="post" asp-page-handler="SendConfirmation">
            <button type="submit" class="secondary">Bestätigungsmail senden</button>
        </form>
    }
    @if (Model.Roles.Count > 0)
    {
        <p>Rollen: @string.Join(", ", Model.Roles)</p>
    }
    <form method="post">
        <label asp-for="DisplayName"></label>
        <input asp-for="DisplayName" autocomplete="name" />
        <span asp-validation-for="DisplayName" class="field-error"></span>
        <div class="actions"><button type="submit">Speichern</button></div>
    </form>
</div>
