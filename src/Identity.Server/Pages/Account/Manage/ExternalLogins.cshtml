@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Externe Konten";
    ViewData["ManagePage"] = "logins";
}
<h1>Mein Konto</h1>
<partial name="_ManageNav" />
<div class="card">
    <h2>Verknüpfte Konten</h2>
    @if (Model.Logins.Count > 0)
    {
        <div class="table-wrap">
            <table>
                <tbody>
                    @foreach (var login in Model.Logins)
                    {
                        <tr>
                            <td>@login.ProviderDisplayName</td>
                            <td>
                                @if (Model.CanRemove)
                                {
                                    <form method="post" asp-page-handler="Remove" class="inline">
                                        <input type="hidden" name="loginProvider" value="@login.LoginProvider" />
                                        <input type="hidden" name="providerKey" value="@login.ProviderKey" />
                                        <button type="submit" class="danger">Trennen</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="muted">Keine externen Konten verknüpft.</p>
    }

    @if (Model.AvailableProviders.Count > 0)
    {
        <h2>Konto verknüpfen</h2>
        <form method="post" asp-controller="ExternalLogin" asp-action="Link" class="actions">
            @foreach (var provider in Model.AvailableProviders)
            {
                <button type="submit" name="provider" value="@provider" class="secondary">@provider</button>
            }
        </form>
    }
</div>
