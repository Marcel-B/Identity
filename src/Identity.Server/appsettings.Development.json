{
  "ConnectionStrings": {
    "Identity": "Data Source=identity-dev.db"
  },
  "Server": {
    "DisplayName": "Identity (Dev)",
    "RequireConfirmedEmail": false,
    "RequireHttps": false
  },
  "Seed": {
    "Admin": { "Email": "admin@localhost", "Password": "Admin12345!" },
    "Scopes": [
      { "Name": "demo-api", "DisplayName": "Demo API", "Resources": [ "demo-api" ] }
    ],
    "Clients": [
      {
        "ClientId": "demo-web",
        "ClientSecret": "dev-secret-change-me",
        "DisplayName": "Demo Web App",
        "ConsentType": "implicit",
        "GrantTypes": [ "authorization_code", "refresh_token" ],
        "RedirectUris": [ "http://localhost:5010/signin-oidc" ],
        "PostLogoutRedirectUris": [ "http://localhost:5010/signout-callback-oidc" ],
        "Scopes": [ "demo-api" ]
      },
      {
        "ClientId": "demo-service",
        "ClientSecret": "dev-secret-change-me",
        "DisplayName": "Demo Service",
        "GrantTypes": [ "client_credentials" ],
        "Scopes": [ "demo-api" ]
      }
    ]
  }
}
